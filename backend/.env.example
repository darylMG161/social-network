# Port du serveur
PORT=5000

# Connexion MongoDB (local ou Atlas)
MONGO_URI=mongodb://localhost:27017/social-network

# Secret JWT — À CHANGER en production (chaîne longue et aléatoire)
JWT_SECRET=change-this-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d

# URL du frontend (pour la config CORS)
CLIENT_URL=http://localhost:5173

# Environnement
NODE_ENV=development
